    <munit:test name="delete-customer-db-error-handled-gracefully" description="A DB error during delete should be caught by the flow's own error handler and produce a generic BANK-5000 failure envelope">
        <munit:behavior>
            <munit-tools:mock-when processor="db:delete" doc:name="Mock Delete Customer">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Delete Customer"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:error typeId="DB:QUERY_EXECUTION"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set Event">
                <munit:attributes value="#[{ uriParams: { customerId: '1' } }]" mediaType="application/java"/>
            </munit:set-event>
            <try doc:name="Try">
                <flow-ref name="delete-customer-flow" doc:name="Call Delete Flow"/>
                <error-handler>
                    <on-error-continue type="ANY" doc:name="Catch Any Error">
