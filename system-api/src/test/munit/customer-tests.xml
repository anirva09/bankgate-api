    <munit:test name="onboard-customer-invalid-email-validation" description="Malformed email should raise VALIDATION:VALIDATION">
        <munit:execution>
            <munit:set-event doc:name="Set Event">
                <munit:payload value='#[{"first_name": "Jane", "last_name": "Doe", "email": "not-an-email"}]' mediaType="application/java"/>
            </munit:set-event>
            <try doc:name="Try">
                <flow-ref name="banking-customer-onboarding-apiFlow" doc:name="Call Onboard Flow"/>
                <error-handler>
                    <on-error-continue type="VALIDATION:VALIDATION" doc:name="Catch Validation Error">
                        <set-variable variableName="caughtErrorType" value="VALIDATION:VALIDATION" doc:name="Record Error Type"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caughtErrorType]" is="#[MunitTools::equalTo('VALIDATION:VALIDATION')]" doc:name="Assert Error Type"/>
        </munit:validation>
    </munit:test>

    <munit:test name="onboard-customer-duplicate-conflict" description="Duplicate email/phone/PAN/Aadhaar should raise BANKING:CONFLICT">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select" doc:name="Mock Check Duplicate Customer">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Check Duplicate Customer"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[{customer_id: 1}]]" mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set Event">
                <munit:payload value='#[{"first_name": "Jane", "last_name": "Doe", "email": "jane.doe@example.com", "phone": "9000000001", "pan": "ABCDE1234F", "aadhaar": "123456789012"}]' mediaType="application/java"/>
            </munit:set-event>
            <try doc:name="Try">
                <flow-ref name="banking-customer-onboarding-apiFlow" doc:name="Call Onboard Flow"/>
                <error-handler>
                    <on-error-continue type="BANKING:CONFLICT" doc:name="Catch Conflict Error">
                        <set-variable variableName="caughtErrorType" value="BANKING:CONFLICT" doc:name="Record Error Type"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caughtErrorType]" is="#[MunitTools::equalTo('BANKING:CONFLICT')]" doc:name="Assert Error Type"/>
        </munit:validation>
    </munit:test>

