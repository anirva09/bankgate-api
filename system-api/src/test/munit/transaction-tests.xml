                <error-handler>
                    <on-error-continue type="BANKING:ACCOUNT_NOT_FOUND" doc:name="Catch Not Found Error">
                        <set-variable variableName="caughtErrorType" value="BANKING:ACCOUNT_NOT_FOUND" doc:name="Record Error Type"/>
                    </on-error-continue>
