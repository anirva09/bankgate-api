        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caughtErrorType]" is="#[MunitTools::equalTo('BANKING:ACCOUNT_NOT_FOUND')]" doc:name="Assert Error Type"/>
        </munit:validation>
    </munit:test>

