<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
      http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd">

    <!-- ================================= -->
    <!-- GLOBAL CONFIG -->
    <!-- ================================= -->

    <http:listener-config name="Experience_HTTP_Listener_config" doc:name="Experience HTTP Listener Config">
        <http:listener-connection host="0.0.0.0" port="8080"/>
    </http:listener-config>

    <http:request-config name="Process_API_Request_config" doc:name="Process API Request Config">
        <http:request-connection host="localhost" port="8082"/>
    </http:request-config>

    <http:request-config name="Auth_Service_Request_config" doc:name="Auth Service Request Config">
        <http:request-connection host="localhost" port="8084"/>
    </http:request-config>


    <!-- ================================= -->
    <!-- SHARED SUBFLOW: TRACE ID + TIMER -->
    <!-- ================================= -->

    <api-gateway:autodiscovery apiId="21097166" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="54116181-6896-4229-b77a-9b154d67d8ed" flowRef="experience-get-account-by-number-flow" />
	<sub-flow name="capture-trace-id-subflow" doc:name="Capture Trace Id">
        <set-variable
                variableName="startTime"
                value="#[now()]"
                doc:name="Start Timer"/>
        <set-variable
                variableName="traceId"
                value="#[attributes.headers.'X-Correlation-Id' default correlationId]"
                doc:name="Store Trace Id"/>
    </sub-flow>


    <!-- ================================= -->
    <!-- SHARED SUBFLOW: VALIDATE ACCESS TOKEN -->
    <!-- ================================= -->

    <sub-flow name="validate-token-subflow" doc:name="Validate Access Token">

        <choice doc:name="Check Authorization Header Present">
            <when expression="#[isEmpty(attributes.headers.'Authorization' default '') or not (attributes.headers.'Authorization' default '' startsWith 'Bearer ')]">
                <raise-error
                        type="AUTH:UNAUTHORIZED"
                        description="Missing or malformed Authorization header - expected 'Bearer' followed by a token"
                        doc:name="Missing Bearer Token"/>
            </when>
        </choice>

        <set-variable
                variableName="accessToken"
                value="#[(attributes.headers.'Authorization')[7 to -1]]"
                doc:name="Extract Token"/>

        <!--
            target="introspectionResult" stores the introspect call's
            result in a variable instead of overwriting payload/
            attributes, preserving the original inbound request's
            uriParams for the rest of the flow.
        -->
        <http:request
                method="POST"
                config-ref="Auth_Service_Request_config"
                path="/oauth/introspect"
                target="introspectionResult"
                doc:name="Introspect Token">
            <http:body><![CDATA[#[%dw 2.0
output application/json
---
{ token: vars.accessToken }]]]></http:body>
        </http:request>

        <!--
            FIX: the default targetValue for http:request's "target" is
            #[payload], so vars.introspectionResult IS the decoded JSON
            body directly (e.g. {active: true, clientId: "..."}) - it is
            NOT wrapped in a {payload, attributes} object. The previous
            check read vars.introspectionResult.payload.active, which
            doesn't exist and always evaluated to null, so every request
            was rejected regardless of what Auth actually returned.
        -->
        <choice doc:name="Check Token Active">
            <when expression="#[vars.introspectionResult.active != true]">
                <raise-error
                        type="AUTH:UNAUTHORIZED"
                        description="Invalid or expired access token"
                        doc:name="Invalid Token"/>
            </when>
        </choice>

    </sub-flow>


    <!-- ================================= -->
    <!-- CREATE ACCOUNT -->
    <!-- POST /accounts -->
    <!-- ================================= -->

    <flow name="experience-create-account-flow">

        <http:listener
                config-ref="Experience_HTTP_Listener_config"
                path="/accounts"
                allowedMethods="POST"
                doc:name="Create Account">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:body>#[payload]</http:body>
                <http:headers><![CDATA[#[{'X-Correlation-Id': vars.traceId}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 502]">
                <http:body>#[payload]</http:body>
            </http:error-response>
        </http:listener>

        <flow-ref name="capture-trace-id-subflow" doc:name="Capture Trace Id"/>
        <flow-ref name="validate-token-subflow" doc:name="Validate Token"/>

        <logger
                level="INFO"
                message="Experience API: received create-account request"
                doc:name="Logger"/>

        <http:request
                method="POST"
                config-ref="Process_API_Request_config"
                path="/accounts"
                doc:name="Call Process API">
            <http:body><![CDATA[#[payload]]]></http:body>
            <http:headers><![CDATA[#[{'X-Correlation-Id': vars.traceId}]]]></http:headers>
            <http:response-validator>
                <http:success-status-code-validator values="0..599"/>
            </http:response-validator>
        </http:request>

        <set-variable
                variableName="httpStatus"
                value="#[attributes.statusCode]"
                doc:name="Capture Downstream Status"/>

        <logger
                level="INFO"
                message="#[write({
                    correlationId: vars.traceId,
                    flow: 'experience-create-account-flow',
                    httpStatus: vars.httpStatus,
                    durationMs: (now() as Number {unit: 'milliseconds'}) - (vars.startTime as Number {unit: 'milliseconds'}),
                    outcome: if (vars.httpStatus &lt; 400) 'SUCCESS' else 'DOWNSTREAM_ERROR'
                }, 'application/json')]"
                doc:name="Experience Log"/>

        <error-handler>
            <on-error-continue
                    type="AUTH:UNAUTHORIZED"
                    enableNotifications="true"
                    doc:name="Unauthorized Handler">
                <set-variable
                        variableName="httpStatus"
                        value="#[401]"
                        doc:name="Set 401"/>
                <ee:transform doc:name="Build Unauthorized Response" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core">
                    <ee:message>
                        <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "FAILED",
    errorCode: "BANK-4011",
    message: error.description,
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss"},
    correlationId: vars.traceId default correlationId
}
                        ]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
                <logger
                        level="WARN"
                        message="#[write({
                            correlationId: vars.traceId default correlationId,
                            flow: 'experience-create-account-flow',
                            httpStatus: 401,
                            outcome: 'UNAUTHORIZED'
                        }, 'application/json')]"
                        doc:name="Unauthorized Log"/>
            </on-error-continue>
            <on-error-continue
                    type="HTTP:CONNECTIVITY, HTTP:TIMEOUT"
                    enableNotifications="true"
                    doc:name="Process API Unreachable">
                <set-variable
                        variableName="httpStatus"
                        value="#[503]"
                        doc:name="Set 503"/>
                <set-payload
                        mimeType="application/json"
                        value='#[{
                            "status":"ERROR",
                            "message":"Process API is unavailable",
                            "errorCode":"BANK-5032"
                        }]'
                        doc:name="Downstream Unavailable Response"/>
                <logger
                        level="ERROR"
                        message="#[write({
                            correlationId: vars.traceId,
                            flow: 'experience-create-account-flow',
                            httpStatus: 503,
                            outcome: 'PROCESS_API_DOWN'
                        }, 'application/json')]"
                        doc:name="Connectivity Error Log"/>
            </on-error-continue>
        </error-handler>

    </flow>


